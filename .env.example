DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/manifestations
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Token Bearer exigé par les routes d'écriture et de tâches (ex: openssl rand -hex 32)
API_TOKEN=
# Clé API Perplexity (ne jamais commiter)
PERPLEXITY_API_KEY=
# Dossier des captures Playwright
SCREENSHOT_DIR=screenshots
# Transcription (faster-whisper)
WHISPER_MODEL=tiny
MAX_VIDEO_DURATION_SECONDS=180
# Requêtes TikTok planifiées, séparées par des points-virgules
TIKTOK_QUERIES=manifestation;violences policières manifestation

# Mode d'analyse : web (cookie de session perplexity.ai, par défaut) ou api
PERPLEXITY_MODE=web
# Valeur du cookie __Secure-next-auth.session-token (ou chaîne "nom=valeur; nom2=valeur2").
# Secret : le coller à la main dans le .env du serveur (chmod 600), ne jamais le commiter.
PERPLEXITY_SESSION_COOKIE=
