[Unit]
Description=Manifestations API (FastAPI)
After=network.target postgresql.service

[Service]
User=manifestations
WorkingDirectory=/opt/manifestations-bo
EnvironmentFile=/opt/manifestations-bo/.env
ExecStart=/opt/manifestations-bo/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
