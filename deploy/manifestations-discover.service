[Unit]
Description=Planifie les découvertes TikTok (tâches en file)
After=postgresql.service

[Service]
Type=oneshot
User=manifestations
WorkingDirectory=/opt/manifestations-bo
EnvironmentFile=/opt/manifestations-bo/.env
ExecStart=/opt/manifestations-bo/.venv/bin/python -m app.worker enqueue-tiktok
